{
  "name": "commissioning/commission",
  "description": "Commissioning Symfony component",
  "type": "symfony-bundle",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "collectioning/collection": "dev-master",
    "cruding/crud": "dev-master",
    "failing/failure": "dev-master",
    "easycorp/easyadmin-bundle": "^5.0",
    "nelmio/api-doc-bundle": "^5.0",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "tabling/table": "dev-master",
    "viewing/view": "dev-master",
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.3",
    "symfony/doctrine-bridge": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/runtime": "^8.1",
    "symfony/security-bundle": "^8.1",
    "symfony/serializer": "^8.1",
    "symfony/twig-bundle": "^8.1",
    "symfony/yaml": "^8.1"
  },
  "autoload": {
    "psr-4": {
      "App\\Commissioning\\": "src/"
    }
  },
  "extra": {
    "symfony": {
      "bundle": "App\\Commissioning\\CommissioningBundle",
      "require": "8.1.*"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "allow-plugins": {
      "symfony/runtime": true
    }
  },
  "require-dev": {
    "gating/gate": "dev-master"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/smartresponsor/failing.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "https://github.com/smartresponsor/gating.git",
      "no-api": true
    }
  ]
}
